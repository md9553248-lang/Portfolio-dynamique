# Copiez ce fichier en ".env" (Copy-Item .env.example .env) puis adaptez les valeurs.
# Le fichier ".env" ne doit JAMAIS être ajouté à Git. Toutes les valeurs ci-dessous sont fictives.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Adresse du site (origine autorisée par CORS). En production : https obligatoire.
CLIENT_ORIGIN=http://localhost:5173

# MySQL (utilisé à partir de la Phase 04). Ne JAMAIS utiliser "root" ici.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio
DB_USER=portfolio_app
DB_PASSWORD=change-me-mot-de-passe-mysql

# Secret de session : générez une vraie valeur aléatoire (voir README). Minimum 32 caractères.
SESSION_SECRET=change-me-generate-a-random-secret-here

# Stockage des fichiers (CV, médias)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
CV_MAX_SIZE_MB=5
