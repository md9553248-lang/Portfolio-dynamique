# Copiez ce fichier en ".env" (Copy-Item .env.example .env) puis adaptez les valeurs.
# Le fichier ".env" ne doit JAMAIS être ajouté à Git. Toutes les valeurs ci-dessous sont fictives.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Adresse du site (origine autorisée par CORS). En production : https obligatoire.
CLIENT_ORIGIN=http://localhost:5173

# Nombre de reverse proxies devant l'application (0 en local, généralement 1 en production).
TRUST_PROXY=0

# --- MySQL ---------------------------------------------------------------------------------------
# Compte de l'application : droits minimaux (lecture/écriture des données). Ne JAMAIS utiliser "root".
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio
DB_USER=portfolio_app
DB_PASSWORD=change-me-mot-de-passe-app

# Compte réservé aux migrations (npm run db:migrate). Il peut modifier la structure des tables.
DB_MIGRATION_USER=portfolio_migrator
DB_MIGRATION_PASSWORD=change-me-mot-de-passe-migration

# Connexion chiffrée à MySQL : mettez "true" si la base est sur un autre serveur.
DB_SSL=false

# Base utilisée par les tests d'intégration (son nom doit se terminer par _test).
# Laissez cette ligne commentée si vous ne voulez pas exécuter ces tests.
# DB_TEST_NAME=portfolio_test

# --- Sessions ------------------------------------------------------------------------------------
# Secret de session : générez une vraie valeur aléatoire (voir README). Minimum 32 caractères.
SESSION_SECRET=change-me-generate-a-random-secret-here

# --- Stockage des fichiers (CV, médias) ----------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
CV_MAX_SIZE_MB=5
